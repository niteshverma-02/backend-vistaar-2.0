# Copy to .env and fill in. Never commit .env (see .gitignore).
# Every variable is declared and validated in src/config/env.schema.ts.

NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# CRM-Database, shared with ko-sales and every other portal. Ask the TL for the
# beta URI; never point a local run at production.
MONGODB_URI=
MONGODB_DB_NAME=CRM-Database
# Connections per process (processes × max must fit the Mongo server's limit)
MONGODB_MAX_POOL_SIZE=50
MONGODB_MIN_POOL_SIZE=5
# Test-data seeds (seed-test-*, seed-feedback, seed-banners) run only when every
# host in MONGODB_URI is listed here, comma-separated. Beta / local only — never
# set it in production.
SEED_ALLOW_HOSTS=

# pnpm start:cluster — worker processes, 0 = one per CPU core
WEB_CONCURRENCY=0

# Comma-separated browser origins (HO portal hosts). Empty = none, * = any.
CORS_ORIGINS=*

LOG_LEVEL=info
SWAGGER_ENABLED=true

# ── Partner sessions ──────────────────────────────────────────────────────
# 32+ random characters, e.g. `openssl rand -base64 48`. Unique to this service.
VISTAAR_JWT_SECRET=
ACCESS_TOKEN_TTL_SECONDS=43200
REFRESH_TOKEN_TTL_DAYS=30

# ── OTP (utilities service) ───────────────────────────────────────────────
OTP_API_URL=https://utils.ko-tech.in
OTP_TIMEOUT_MS=10000
# Order service → POST /api/v2/hooks/orders/confirmed (header x-webhook-secret).
# Unset = the route is off. At least 24 characters; share it with the order service only.
ORDER_EVENTS_SECRET=

# Online payment kill switch. false = the app shows no online payment option,
# whatever HO switched on in the portal. true needs PAYMENTS_CREDENTIALS_KEY below,
# or the server will not start.
PAYMENTS_ONLINE_ENABLED=false
# Seals the merchant keys HO enters (AES-256-GCM). 32 random bytes, base64:
#   openssl rand -base64 32
# Never in Mongo, never shared. Required when PAYMENTS_ONLINE_ENABLED=true.
# PAYMENTS_CREDENTIALS_KEY=
PAYMENTS_CREDENTIALS_KEY_ID=k1
# Slack incoming webhook for every payment-key change (optional, recommended).
# PAYMENTS_ALERT_WEBHOOK_URL=

# Non-production only: numbers that accept OTP_TEST_CODE without an SMS.
OTP_TEST_NUMBERS=
OTP_TEST_CODE=

# ── HO portal (SSO) ───────────────────────────────────────────────────────
SSO_JWKS_URL=https://sso.ko-tech.in/.well-known/jwks.json

# ── KYC uploads (Firebase Storage, same project as ko-sales) ─────────────
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_STORAGE_BUCKET=
# B2B Sales marketplace API — the catalogue the cart is priced from.
# No token here: B2B tokens belong to signed-in agents and expire, so each
# cart request carries the agent's own (x-b2b-token header).
B2B_API_URL=https://api.b2bsales.ko-tech.in/api/v1
B2B_MARKETPLACE_CODE=MKTP-1
# ko-sales Customer Session — the Vistaar platform key (kp.vistaar.…) from
# sales-operations → Customer Session → Generate key. Server only, never the app.
# Empty = POST /auth/customer-session answers 503 CUSTOMER_SESSION_OFF.
KATYAYANI_PLATFORM_KEY=
CATALOG_CACHE_TTL_SECONDS=60
